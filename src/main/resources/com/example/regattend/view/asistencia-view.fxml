<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.AsistenciaController">
    <top>
        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Control de Asistencia Diaria" />
            <Label fx:id="lblUsuarioLogueado" style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;" text="Usuario: Creado" />
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label fx:id="lblEstadoHoy" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Estado de hoy: No registrado" />
            <VBox alignment="CENTER" spacing="15.0">
                <Button fx:id="btnMarcarEntrada" onAction="#handleMarcarEntrada" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;" text="Marcar Entrada" />
                <Button fx:id="btnMarcarSalida" onAction="#handleMarcarSalida" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #c0392b; -fx-text-fill: white; -fx-font-size: 14px;" text="Marcar Salida" />
            </VBox>
            <Label fx:id="lblMensajeAccion" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
        </VBox>
    </center>
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 10px;">
            <Button onAction="#handleVolverPanel" style="-fx-base: #7f8c8d; -fx-text-fill: white;" text="Volver al Panel Principal" />
        </VBox>
    </bottom>
</BorderPane>