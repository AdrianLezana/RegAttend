<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.AsistenciaController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Asistencia" />

    <Label fx:id="lblEstado" style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Estado de hoy: No registrado" />

    <Button fx:id="btnEntrada" onAction="#handleRegistrarEntrada" prefWidth="220.0" style="-fx-base: #27ae60; -fx-text-fill: white;" text="Marcar Entrada" />

    <Button fx:id="btnSalida" onAction="#handleRegistrarSalida" prefWidth="220.0" style="-fx-base: #c0392b; -fx-text-fill: white;" text="Marcar Salida" />

    <Button onAction="#handleVolver" prefWidth="150.0" style="-fx-base: #7f8c8d; -fx-text-fill: white;" text="Volver" />
</VBox>
