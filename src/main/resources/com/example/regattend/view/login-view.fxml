<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <VBox alignment="CENTER" maxWidth="320.0" spacing="15.0" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
            </padding>
            <children>
                <Label text="RegAttend" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Sistema de Control de Asistencia" textFill="#7f8c8d">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="Correo Electrónico:" textFill="#34495e" />
                    <TextField fx:id="txtCorreo" promptText="ejemplo@empresa.com" />
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="Contraseña:" textFill="#34495e" />
                    <PasswordField fx:id="txtPassword" promptText="••••••••" />
                </VBox>

                <Button fx:id="btnIngresar" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="270.0" styleClass="button-primary" text="Iniciar Sesión" />

                <Label fx:id="lblMensaje" textFill="#e74c3c">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </children>
</VBox>