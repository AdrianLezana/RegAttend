<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom, #ff9966, #ff5e62); -fx-padding: 40;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.UsuarioFormController">

    <Label fx:id="lblTitulo" text="Formulario de Usuario" textFill="WHITE">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <TextField fx:id="txtNombre" promptText="Nombre Completo" maxWidth="300" style="-fx-background-radius: 10; -fx-padding: 10;"/>
    <TextField fx:id="txtCorreo" promptText="Correo Electrónico" maxWidth="300" style="-fx-background-radius: 10; -fx-padding: 10;"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña (solo al crear)" maxWidth="300" style="-fx-background-radius: 10; -fx-padding: 10;"/>

    <ComboBox fx:id="cbRol" promptText="Seleccionar Rol" maxWidth="300" style="-fx-background-radius: 10; -fx-padding: 5;"/>

    <HBox alignment="CENTER" spacing="20.0" style="-fx-margin-top: 10px;">
        <Button text="Guardar" onAction="#guardarUsuario" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;" prefWidth="120" prefHeight="40"/>
        <Button text="Cancelar" onAction="#cancelar" style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-background-radius: 15; -fx-border-radius: 15;" prefWidth="120" prefHeight="40"/>
    </HBox>
</VBox>