<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.UsuarioFormController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Registrar Nuevo Usuario" />

    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" />

    <TextField fx:id="txtNombre" promptText="Nombre completo" />

    <TextField fx:id="txtCorreo" promptText="Correo electrónico" />

    <PasswordField fx:id="txtPassword" promptText="Contraseña temporal" />

    <ComboBox fx:id="cmbRol" prefWidth="220.0" promptText="Seleccionar Rol" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleGuardar" style="-fx-base: #27ae60; -fx-text-fill: white;" text="Guardar" />
        <Button onAction="#handleCancelar" style="-fx-base: #7f8c8d; -fx-text-fill: white;" text="Cancelar" />
    </HBox>
</VBox>