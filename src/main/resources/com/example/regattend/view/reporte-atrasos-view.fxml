<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.ReporteAtrasosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #d35400; -fx-padding: 15px;">
            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Reporte de Atrasos" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#handleVolver" style="-fx-base: #7f8c8d; -fx-text-fill: white;" text="Volver" />
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Label fx:id="lblFechaReporte" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Fecha:" />
            <TableView fx:id="tablaAtrasos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdUsuario" prefWidth="100.0" text="ID Usuario" />
                    <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                    <TableColumn fx:id="colHoraEntrada" prefWidth="150.0" text="Hora Entrada" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>