<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.ReporteController">

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-padding: 15; -fx-background-radius: 10;">
        <Label text="Panel de Reportes" textFill="WHITE">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Cerrar Sesión" onAction="#cerrarSesion" style="-fx-background-color: white; -fx-text-fill: #11998e; -fx-font-weight: bold; -fx-background-radius: 15;"/>
        <Button text="Gestionar Usuarios" onAction="#gestionarUsuarios" style="-fx-background-color: #8e2de2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER">
        <!-- Botón para limpiar filtros -->
        <Button text="Ver Todos" onAction="#cargarHistorialCompleto" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="120"/>


        <Button text="Atrasos (> 09:30)" onAction="#generarReporteAtrasos" style="-fx-background-color: #f2994a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="150"/>
        <Button text="Salidas Anticipadas" onAction="#generarReporteSalidasAnticipadas" style="-fx-background-color: #eb5757; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="150"/>
        <Button text="Inasistencias (Hoy)" onAction="#generarReporteInasistencias" style="-fx-background-color: #56ccf2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="150"/>

        <!-- Botón de Excel -->
        <Button text="Exportar a Excel" onAction="#exportarExcel" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="150"/>
    </HBox>

    <TableView fx:id="tablaReportes" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre Empleado" prefWidth="250">
                <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="fecha" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colHora" text="Hora" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="hora" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="detalle" /></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>