<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.ReporteController">

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-padding: 15; -fx-background-radius: 10;">
        <Label text="Panel de Reportes" textFill="WHITE">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Cerrar Sesión" onAction="#cerrarSesion" style="-fx-background-color: white; -fx-text-fill: #11998e; -fx-font-weight: bold; -fx-background-radius: 15;"/>
        <Button text="Gestionar Usuarios" onAction="#gestionarUsuarios" style="-fx-background-color: #8e2de2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER">
        <Button text="Atrasos (> 09:30)" onAction="#generarReporteAtrasos" style="-fx-background-color: #f2994a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="180"/>
        <Button text="Salidas Anticipadas" onAction="#generarReporteSalidasAnticipadas" style="-fx-background-color: #eb5757; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="180"/>
        <Button text="Inasistencias (Hoy)" onAction="#generarReporteInasistencias" style="-fx-background-color: #56ccf2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="40" prefWidth="180"/>
    </HBox>

    <ListView fx:id="listViewReportes" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-font-size: 15px; -fx-padding: 5;"/>
</VBox>