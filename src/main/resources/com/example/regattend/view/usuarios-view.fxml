<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: linear-gradient(to right, #8e2de2, #4a00e0); -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.UsuarioController">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Gestión de Usuarios" textFill="WHITE">
            <font><Font name="System Bold" size="26.0" /></font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Volver al Panel" onAction="#volver" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 10; -fx-text-fill: white;"/>
    </HBox>

    <HBox spacing="15.0">
        <Button text="+ Nuevo Usuario" onAction="#abrirFormularioNuevo" style="-fx-background-color: #00c6ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="35"/>
        <Button text="Editar Seleccionado" onAction="#abrirFormularioEditar" style="-fx-background-color: #f2994a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="35"/>
        <Button text="Eliminar (Soft Delete)" onAction="#eliminarUsuario" style="-fx-background-color: #eb5757; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" prefHeight="35"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50">
                <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="correo" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="rol" /></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>