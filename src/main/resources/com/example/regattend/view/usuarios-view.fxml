<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regattend.controller.UsuarioController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
         <Label fx:id="lblBienvenida" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Bienvenido" />
         <HBox HBox.hgrow="ALWAYS" />
         <Button fx:id="btnIrAsistencia" onAction="#handleIrAsistencia" style="-fx-base: #27ae60; -fx-text-fill: white;" text="Marcar Asistencia" />
         <Button fx:id="btnIrReportes" onAction="#handleIrReportes" style="-fx-base: #2980b9; -fx-text-fill: white;" text="Ver Reportes" />
         <Button onAction="#handleCerrarSesion" style="-fx-base: #e74c3c; -fx-text-fill: white;" text="Cerrar Sesión" />
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Listado de Trabajadores Activos" />
         <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
               <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
               <TableColumn fx:id="colCorreo" prefWidth="220.0" text="Correo" />
               <TableColumn fx:id="colRol" prefWidth="120.0" text="Rol" />
            </columns>
         </TableView>
      </VBox>
   </center>
</BorderPane>